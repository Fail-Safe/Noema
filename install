#!/bin/zsh

set -euo pipefail

repo_dir=${0:A:h}
binary_name=noema
install_dir=${NOEMA_INSTALL_DIR:-"$HOME/.local/bin"}

case "$(uname -s)" in
    Darwin) host_os=darwin ;;
    Linux) host_os=linux ;;
    *)
        print -u2 "error: unsupported host OS: $(uname -s)"
        exit 1
        ;;
esac

case "$(uname -m)" in
    arm64|aarch64) host_arch=arm64 ;;
    x86_64|amd64) host_arch=amd64 ;;
    *)
        print -u2 "error: unsupported host architecture: $(uname -m)"
        exit 1
        ;;
esac

artifact="$repo_dir/dist/$binary_name-$host_os-$host_arch"
destination="$install_dir/$binary_name"

print "Building and smoke-testing Noema for $host_os/$host_arch"
make -C "$repo_dir" release-check

if [[ ! -x "$artifact" ]]; then
    print -u2 "error: release artifact not found: $artifact"
    exit 1
fi

install -d "$install_dir"
install -m 0755 "$artifact" "$destination"

if [[ "$host_os" == darwin ]]; then
    if ! command -v codesign >/dev/null 2>&1; then
        print -u2 "error: codesign is required to install the macOS binary"
        exit 1
    fi
    codesign --force --sign - "$destination"
    "$repo_dir/scripts/reconcile-launchd-agents.zsh" "$destination"
fi

print "Installed: $destination"
"$destination" version

resolved=$(command -v "$binary_name" 2>/dev/null || true)
if [[ -z "$resolved" ]]; then
    print -u2 "warning: $install_dir is not currently on PATH"
elif [[ "${resolved:A}" != "${destination:A}" ]]; then
    print -u2 "warning: PATH still resolves noema to $resolved"
    print -u2 "         remove the older binary or place $install_dir earlier on PATH"
fi

print "Installation complete."
